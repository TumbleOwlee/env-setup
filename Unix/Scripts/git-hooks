#!/usr/bin/env bash

hook_wrapper() {
    cat <<'WRAPPER'
#!/usr/bin/env bash

if [ -x "$0.local" ]; then
    "$0.local" "$@" || exit $?
fi

HOOK="$(dirname "$(readlink -f "$0")")/$(basename "$0")"
if [ -x "$HOOK" ]; then
    "$HOOK" "$@" || exit $?
fi
WRAPPER
}

hook_clang_format() {
    cat <<'HOOK'
#!/usr/bin/env bash

script_dir=$( cd -- "$( dirname -- "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )

cd "$script_dir/../" || exit 1

if ! command -v clang-format > /dev/null 2>&1; then
    echo -e "\n\e[31m  ERROR: Commit aborted. Formatter clang-format is missing. Please install clang-format for style check.\e[0m\n"
    exit 1
fi

version=$(clang-format --version | grep -oE '[0-9]+' | head -1)
if [ "${version:-0}" -lt 18 ]; then
    echo -e "\n\e[31m  ERROR: Commit aborted. Only clang-format v18+ is supported. Please update clang-format.\e[0m\n"
    exit 1
fi

if [ -f .clang-format ]; then
    style_file=.clang-format
elif [ -f _clang-format ]; then
    style_file=_clang-format
else
    echo -e "\n\e[33m  NOTICE: No .clang-format or _clang-format in repository root. Skipping clang-format style check.\e[0m\n"
    exit 0
fi

# Print the clang-format output for a staged file, or fail with its error.
format_staged() {
    git show ":$1" | clang-format --style="file:${style_file}" --Werror
}

files=()
while IFS= read -r file; do
    if ! errors=$(format_staged "$file" 2>&1 >/dev/null); then
        echo -e "\n\e[31m  ERROR: Commit aborted. clang-format failed on ${file}:\e[0m\n"
        printf "%s\n" "$errors" | sed 's/^/    /'
        echo
        exit 1
    fi
    if ! cmp -s <(git show ":${file}") <(format_staged "$file"); then
        files+=("${file}")
    fi
done < <(git diff --cached --name-only --diff-filter=ACMRT | grep -E "\.(c|cpp|cxx|cc|h|hpp|hxx)$")

if [ "${#files[@]}" -gt 0 ]; then
    echo -e "\n  \e[33mAffected files:\e[0m\n"
    for file in "${files[@]}"; do
        printf "    - %s\n\n" "$file"

        lnum=1
        while IFS= read -r line; do
            if [ $lnum -lt 3 ]; then
                echo -e "          | \e[01;97m$line\e[0m"
            elif [ $lnum -eq 3 ]; then
                echo -e "          | \e[36m$line\e[0m"
            elif [[ $line == +* ]]; then
                echo -e "          | \e[32m$line\e[0m"
            elif [[ $line == -* ]]; then
                echo -e "          | \e[31m$line\e[0m"
            else
                echo -e "          | $line"
            fi
            lnum=$((lnum+1))
        done < <(diff --color -u <(git show ":${file}") <(format_staged "$file"))
        echo
    done
    echo -e "\e[31m  ERROR: Commit aborted. Changes do not match with code style. Run clang-format first.\e[0m\n"
    exit 1
fi
HOOK
}

if ! ROOT_DIR=$(git rev-parse --show-toplevel 2>/dev/null); then
    echo -e "\e[31mERROR: Not inside a git repository.\e[0m" 1>&2
    exit 1
fi
GIT_DIR=$(realpath "$(git rev-parse --git-common-dir)")
GIT_HOOK_DIR="${ROOT_DIR}/.git-hooks"

HOOK_NAMES=(
    "applypatch-msg"
    "commit-msg"
    "post-applypatch"
    "post-commit"
    "post-merge"
    "post-receive"
    "post-update"
    "post-checkout"
    "prepare-commit-msg"
    "pre-applypatch"
    "pre-auto-gc"
    "pre-commit"
    "pre-merge-commit"
    "pre-push"
    "pre-rebase"
    "pre-receive"
    "prepare-commit"
    "push-to-checkout"
    "update"
)

cd "${ROOT_DIR}" || exit 1

echo ""
if [ -z "$1" ] || [ "$1" == "install" ]; then
    echo -e "  \e[34mInstall git hooks\e[0m\n"

    mkdir -p "${GIT_HOOK_DIR}"
    hook_wrapper >"${GIT_HOOK_DIR}/hooks-wrapper"
    chmod +x "${GIT_HOOK_DIR}/hooks-wrapper"

    echo -ne "  \e[34m    Install PRE_COMMIT hook for clang-format? [Y/n] \e[0m" 1>&2
    read -r value
    if [ -z "$value" ] || [ "$value" == "y" ] || [ "$value" == "Y" ]; then
        echo -n "          Install hook ... "
        (hook_clang_format >"${GIT_HOOK_DIR}/pre-commit" && chmod +x "${GIT_HOOK_DIR}/pre-commit" && echo -e "\e[32minstalled\e[0m") || echo -e "\e[31mfailed\e[0m"
    fi
    echo ""

    HOOK_DIR="${GIT_DIR}/hooks"
    mkdir -p "${HOOK_DIR}"

    for hook in "${HOOK_NAMES[@]}"; do
        echo -e "  \e[34m    Check hook $HOOK_DIR/$hook\e[0m"
        if [ ! -h "$HOOK_DIR/$hook" ] && [ -x "$HOOK_DIR/$hook" ]; then
            echo -e "          Move existing hook $HOOK_DIR/$hook to $HOOK_DIR/$hook.local"
            mv "$HOOK_DIR/$hook" "$HOOK_DIR/$hook.local"
        fi
        echo -e "          Create symlink from $HOOK_DIR/$hook to ${GIT_HOOK_DIR}/hooks-wrapper"
        ln -s -f "${GIT_HOOK_DIR}/hooks-wrapper" "$HOOK_DIR/$hook"
        echo ""
    done
elif [ "$1" == "uninstall" ]; then
    echo -e "  \e[33mUninstall git hooks\e[0m\n"

    if [ ! -d "${GIT_HOOK_DIR}" ]; then
        echo -e "  \e[34m   No hooks installed.\e[0m"
        exit 1
    fi

    HOOK_DIR="${GIT_DIR}/hooks"
    for hook in "${HOOK_NAMES[@]}"; do
        echo -e "  \e[34m    Check hook $HOOK_DIR/$hook\e[0m"
        if [ -L "$HOOK_DIR/$hook" ] && [ "$(realpath "$HOOK_DIR/$hook")" == "$(realpath "${GIT_HOOK_DIR}/hooks-wrapper")" ]; then
            echo -e "          Remove symlink $HOOK_DIR/$hook"
            rm "$HOOK_DIR/$hook"

            if [ -e "$HOOK_DIR/$hook.local" ]; then
                echo -e "          Restore $HOOK_DIR/$hook.local as $HOOK_DIR/$hook"
                mv "$HOOK_DIR/$hook.local" "$HOOK_DIR/$hook"
            fi
        else
            echo -e "          Nothing to do for $HOOK_DIR/$hook"
        fi
        echo ""
    done
else
    echo -e "  \e[31mERROR: Invalid arguments specified '$*'\e[0m\n"
    exit 1
fi
