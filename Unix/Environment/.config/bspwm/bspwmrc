#! /bin/sh

# Set configuration
bspc config border_width 1
bspc config window_gap 2
bspc config split_ratio 0.50
bspc config borderless_monocle true
bspc config gapless_monocle true
bspc config pointer_follows_focus false
bspc config focus_follows_pointer true

# Border
bspc config focused_border_color "#8f7c56"
bspc config normal_border_color "#073642"
bspc config active_border_color "#073642"

# Assign application to workspaces
bspc rule -a keepassxc desktop='III'

#################################################################################
#                                 Autostart                                     #
#################################################################################

# Start sxhkd for keybindings
pgrep -x sxhkd >/dev/null || sxhkd &

# Set display from arandr saved script
sh ~/.screenlayout/monitor.sh &

# Assign workspaces to displays (contiguous blocks of the 10 Roman desktops)
MONITOR_PRIMARY=""
# shellcheck disable=SC1090,SC1091
[ -f "$HOME/.config/env-setup/local.conf" ] && . "$HOME/.config/env-setup/local.conf"

# Monitor order: MONITOR_PRIMARY first (if set), then bspc order
mons=""
if [ -n "$MONITOR_PRIMARY" ]; then
    mons="$MONITOR_PRIMARY"
fi
for m in $(bspc query -M --names); do
    [ "$m" = "$MONITOR_PRIMARY" ] || mons="$mons $m"
done
# shellcheck disable=SC2086
set -- $mons
n=$#
if [ "$n" -gt 0 ]; then
    base=$((10 / n))
    extra=$((10 % n))
    idx=0
    start=1
    for mon in "$@"; do
        count=$base
        [ "$idx" -lt "$extra" ] && count=$((base + 1))
        desktops=""
        d=$start
        while [ "$d" -lt $((start + count)) ]; do
            desktops="$desktops $(echo "I II III IV V VI VII VIII IX X" | cut -d' ' -f"$d")"
            d=$((d + 1))
        done
        # shellcheck disable=SC2086
        bspc monitor "$mon" -d $desktops
        start=$((start + count))
        idx=$((idx + 1))
    done
fi

# Bar
~/.config/polybar/launch.sh &

# Notifications
/usr/bin/dunst &

# Polkit
/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 &

# Wallpaper
nitrogen --set-zoom-fill "$HOME/.backgrounds/wow-horde.jpg" &

# Dex
dex -a -s "/etc/xdg/autostart/:$HOME/.config/autostart/" &

# Picom
picom -b &

# Network Applet
nm-applet --indicator &

# Cursor
xsetroot -cursor_name left_ptr &
